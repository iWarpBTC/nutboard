# PostgreSQL connection for the mint database (Nutshell or CDK). Use a SELECT-only role
# (see scripts/create-readonly-role.sql); nutboard refuses to run if the session is not read-only.
DATABASE_URL=postgres://nutboard_ro:CHANGE_ME@localhost:5432/mint

# IANA time zone. Nutshell stores naive local time, so this must be the zone the mint process
# writes timestamps in: UTC for a mint in a container, the host's zone (e.g. Europe/Prague)
# otherwise; nutboard warns at startup when the configured zone cannot be right.
# CDK stores Unix time: there the zone only decides the hour of day an operation is filed under.
MINT_TZ=UTC

# The exact public address (passkeys are bound to it). Default: http://localhost:PORT
# ORIGIN=https://nutboard.lnpay.cz

# Optional
# AUTH_DB=data/nutboard.db    # SQLite file holding passkeys and sessions
# SETUP_CODE=                 # fixed one-time setup code (>= 12 chars) instead of the random one in the log
# NUTBOARD_AUTH=off           # skip sign-in; only allowed with a localhost ORIGIN on a loopback HOST
# MINT_KIND=auto              # nutshell or cdk; auto looks at the tables in the database
# PG_SCHEMA=public            # schema holding the mint tables
# HOST=127.0.0.1              # bind address (use 0.0.0.0 behind a reverse proxy / in Docker)
# PORT=3737
# MINT_NAME=My mint           # shown in the dashboard header and as the passkey's site name
# CACHE_TTL_SECONDS=30        # how long computed statistics are reused
# STATEMENT_TIMEOUT_MS=30000  # server-side limit for each query
# PG_POOL_MAX=4

# Several mints in one dashboard (instead of DATABASE_URL): ids, then one URL per id.
# MINTS=old,cdk
# MINT_OLD_DATABASE_URL=postgres://nutboard_ro:CHANGE_ME@localhost:5432/cashu_mint
# MINT_OLD_NAME=Old mint          # also MINT_OLD_TZ, MINT_OLD_KIND, MINT_OLD_SCHEMA
# MINT_CDK_DATABASE_URL=postgres://nutboard_ro:CHANGE_ME@localhost:5432/cdk_mint
# MINT_CDK_NAME=New mint
# SITE_NAME=My mints              # name of the dashboard itself

# LNbits (PostgreSQL): balances and payments per wallet. Run scripts/create-readonly-role.sql in that database too.
# LNBITS_DATABASE_URL=postgres://nutboard_ro:CHANGE_ME@localhost:5432/lnbits
# LNBITS_NAME=LNbits
# LNBITS_TZ=UTC                   # zone of the LNbits host

# Kill switch: needs the root-side helper from deploy/killswitch (see deploy/README.md).
# KILL_SWITCH_DIR=/run/nutboard-kill
# KILL_SWITCH_CONF=/etc/nutboard/killswitch.conf
