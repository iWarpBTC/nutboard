# PostgreSQL connection for the Nutshell mint database. Use a SELECT-only role
# (see scripts/create-readonly-role.sql); nutboard refuses to run if the session is not read-only.
DATABASE_URL=postgres://nutboard_ro:CHANGE_ME@localhost:5432/mint

# IANA time zone the mint process writes timestamps in. Nutshell stores naive local
# time: UTC for a mint in a container, the host's zone (e.g. Europe/Prague) otherwise.
# nutboard warns at startup when the configured zone cannot be right.
MINT_TZ=UTC

# The exact public address (passkeys are bound to it). Default: http://localhost:PORT
# ORIGIN=https://nutboard.lnpay.cz

# Optional
# AUTH_DB=data/nutboard.db    # SQLite file holding passkeys and sessions
# SETUP_CODE=                 # fixed one-time setup code (>= 12 chars) instead of the random one in the log
# NUTBOARD_AUTH=off           # skip sign-in; only allowed with a localhost ORIGIN on a loopback HOST
# PG_SCHEMA=public            # schema holding the mint tables
# HOST=127.0.0.1              # bind address (use 0.0.0.0 behind a reverse proxy / in Docker)
# PORT=3737
# MINT_NAME=My mint           # shown in the dashboard header and as the passkey's site name
# CACHE_TTL_SECONDS=30        # how long computed statistics are reused
# STATEMENT_TIMEOUT_MS=30000  # server-side limit for each query
# PG_POOL_MAX=4
